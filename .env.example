# Database configuration
# Local PostgreSQL from Docker Compose
DATABASE_URL=postgresql://learncloud:your_password@localhost:5434/learncloud
# Configure RDS through the same DATABASE_URL setting
# RDS example: DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@RDS_HOST:5432/learncloud?sslmode=verify-full&sslrootcert=C:/certs/global-bundle.pem

# Application configuration
APP_NAME=LearnCloud
DEBUG=true

# AWS configuration (when needed)
AWS_REGION=ap-southeast-1
S3_BUCKET=learncloud-videos-mentorcloud
# Raw video playback requires BOTH settings; keep disabled in production.
APP_ENV=production
ALLOW_RAW_VIDEO_PLAYBACK=false
VIDEO_URL_EXPIRES_IN=900
# Explicit development opt-in only: local queues requests; no worker or AWS workflow.
VIDEO_PROCESSOR_BACKEND=disabled
# LOCAL_VIDEO_JOB_DIR=D:/path/to/local-video-jobs
# Optional AWS pipeline. Leave disabled until manual migration 0005 and Console setup.
VIDEO_PIPELINE_ENABLED=false
# After setup: VIDEO_PROCESSOR_BACKEND=eventbridge (retries use a DB outbox).
MEDIACONVERT_ROLE_ARN=
MEDIACONVERT_QUEUE_ARN=
VIDEO_EVENT_BUS=default
VIDEO_AI_ENABLED=false

# JWT
JWT_SECRET_KEY=<REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Independent backend opt-in. Only APP_ENV=development or test is allowed.
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_JWT_SECRET=
LOCAL_AUTH_JWT_ISSUER=learncloud-local
LOCAL_AUTH_JWT_AUDIENCE=learncloud-api
LOCAL_AUTH_OTP_TTL_SECONDS=600
LOCAL_AUTH_RESEND_SECONDS=60
LOCAL_AUTH_OTP_MAX_ATTEMPTS=5
LOCAL_AUTH_LOGIN_MAX_ATTEMPTS=5
LOCAL_AUTH_LOGIN_LOCK_SECONDS=300
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=LearnCloud <no-reply@learncloud.test>

# Set these once alongside local auth to accept both methods concurrently.
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

LOG_LEVEL=DEBUG
LOG_FORMAT=text
