# Database configuration
# Nếu kết nối fastapi và postgresql với docker
DATABASE_URL=postgresql://learncloud:your_password@localhost:5434/learncloud
# Nếu kết nối fastapi và postgresql với rds của aws
DATABASE_URL=postgresql+psycopg2://learncloud_admin:mentorcloudrds@127.0.0.1:15437/learncloud?sslmode=require

# Application configuration
APP_NAME=LearnCloud
DEBUG=true

# AWS configuration (when needed)
AWS_REGION=ap-southeast-1
S3_BUCKET=learncloud-videos-mentorcloud
# Raw video playback requires BOTH settings; keep disabled in production.
APP_ENV=production
ALLOW_RAW_VIDEO_PLAYBACK=false
VIDEO_URL_EXPIRES_IN=900
# Explicit development opt-in only: local queues requests; no worker or AWS workflow.
VIDEO_PROCESSOR_BACKEND=disabled
# LOCAL_VIDEO_JOB_DIR=D:/path/to/local-video-jobs
# Optional AWS pipeline. Leave disabled until manual migration 0005 and Console setup.
VIDEO_PIPELINE_ENABLED=false
# After setup: VIDEO_PROCESSOR_BACKEND=eventbridge (retries use a DB outbox).
MEDIACONVERT_ROLE_ARN=
MEDIACONVERT_QUEUE_ARN=
VIDEO_EVENT_BUS=default
VIDEO_AI_ENABLED=false

# JWT
JWT_SECRET_KEY=<REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

LOG_LEVEL=DEBUG
LOG_FORMAT=text
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AWS_DEFAULT_REGION=ap-southeast-1
