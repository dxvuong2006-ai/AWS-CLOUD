{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lecture Summary",
  "description": "A concise summary of a lecture and its key concepts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "key_concepts"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "key_concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/key_concept"
      }
    }
  },
  "definitions": {
    "key_concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "definition"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}