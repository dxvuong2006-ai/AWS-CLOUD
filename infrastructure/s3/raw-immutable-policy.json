{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RequireCreateOnlyRawWrites",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::learncloud-videos-mentorcloud/lessons/*/raw/*",
      "Condition": {
        "Null": {
          "s3:if-none-match": "true"
        },
        "Bool": {
          "s3:ObjectCreationOperation": "true"
        }
      }
    }
  ]
}
