{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::learncloud-videos-mentorcloud/lessons/__LESSON_ID__/raw/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::learncloud-videos-mentorcloud/lessons/__LESSON_ID__/processed/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::learncloud-videos-mentorcloud"
    }
  ]
}
